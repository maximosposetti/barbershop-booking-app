generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum ImageCategory {
  SHOP
  HAIRCUT
  BARBER
}

model User {
  id                  String                  @id @default(cuid())
  name                String?
  email               String                  @unique
  emailVerified       DateTime?
  image               String?
  phone               String?
  phoneVerifiedAt     DateTime?
  city                String?
  addressStreet       String?
  addressNumber       String?
  addressFloor        String?
  addressApartment    String?
  passwordHash        String?
  role                Role                    @default(USER)
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  phoneVerifications  PhoneVerificationCode[]
  reservations        Reservation[]
  reviews             Review[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PhoneVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  phone     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  sentAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([phone])
}

model Barber {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  description       String
  imageUrl          String
  active            Boolean            @default(true)
  availabilityRules AvailabilityRule[]
  unavailableBlocks UnavailableBlock[]
  reservations      Reservation[]
  reviews           Review[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model AvailabilityRule {
  id          String @id @default(cuid())
  barberId    String
  weekday     Int
  startTime   String
  endTime     String
  slotMinutes Int    @default(30)
  barber      Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
}

model UnavailableBlock {
  id        String   @id @default(cuid())
  barberId  String
  startAt   DateTime
  endAt     DateTime
  reason    String?
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Reservation {
  id               String            @id @default(cuid())
  userId           String
  barberId         String
  startAt          DateTime
  endAt            DateTime
  status           ReservationStatus @default(PENDING_PAYMENT)
  priceCents       Int               @default(1500000)
  notes            String?
  createdByAdmin   Boolean           @default(false)
  user             User              @relation(fields: [userId], references: [id])
  barber           Barber            @relation(fields: [barberId], references: [id])
  payment          Payment?
  review           Review?
  reviewInvitation ReviewInvitation?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([barberId, startAt])
  @@index([userId, startAt])
}

model BusinessSetting {
  id                String   @id @default("default")
  haircutPriceCents Int      @default(1500000)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Payment {
  id            String        @id @default(cuid())
  reservationId String        @unique
  provider      String        @default("MERCADO_PAGO")
  preferenceId  String?
  externalId    String?
  status        PaymentStatus @default(PENDING)
  amountCents   Int
  rawPayload    Json?
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model GalleryImage {
  id        String        @id @default(cuid())
  title     String
  url       String
  category  ImageCategory
  createdAt DateTime      @default(now())
}

model Review {
  id            String       @id @default(cuid())
  reservationId String?      @unique
  userId        String?
  barberId      String?
  name          String
  rating        Int
  comment       String
  submittedAt   DateTime     @default(now())
  createdAt     DateTime     @default(now())
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  barber        Barber?      @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([barberId])
  @@index([createdAt])
}

model ReviewInvitation {
  id            String      @id @default(cuid())
  reservationId String      @unique
  tokenHash     String      @unique
  sentAt        DateTime?
  usedAt        DateTime?
  expiresAt     DateTime?
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tokenHash])
  @@index([sentAt])
}
